{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Rollout": {
    "FlagFile": "flags/flags.json",
    "FlagKey": "new-pricing-engine",
    "CanaryVariant": "on",
    "BaselineVariant": "off",
    "PrometheusUrl": "http://localhost:9090",
    "TickInterval": "00:00:05",
    "Window": "00:01:00",
    "Steps": [ 10, 25, 50 ],
    "BakeTime": "00:02:00",
    "BreachesToRollback": 2,
    "Policy": "Combined",
    "MaxErrorRate": 0.05,
    "MinRequests": 100,
    "ZCritical": 3.09,
    "MinAbsoluteIncrease": 0.01,
    "AuditLog": ""
  }
}
