{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Flagd": {
    "Host": "localhost",
    "Port": 8013,
    "CacheEnabled": false,
    "InitTimeoutMs": 10000
  },
  "Canary": {
    "FlagKey": "new-pricing-engine"
  },
  "Admin": {
    "ApiKey": ""
  },
  "Faults": {
    "CanaryErrorRate": 0.0,
    "BaselineErrorRate": 0.0
  },
  "Otel": {
    "MetricExportIntervalMs": 5000
  }
}
