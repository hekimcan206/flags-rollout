{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "new-pricing-engine": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": {
        "fractional": [
          { "cat": [ { "var": "$flagd.flagKey" }, { "var": "targetingKey" } ] },
          [ "on", 10 ],
          [ "off", 90 ]
        ]
      },
      "metadata": { "owner": "pricing-team", "ticket": "PRC-142" }
    },
    "checkout-banner": {
      "state": "ENABLED",
      "variants": { "summer": "Summer sale <20% off>", "none": "" },
      "defaultVariant": "none",
      "targeting": { "if": [ { "ends_with": [ { "var": "email" }, "@example.com" ] }, "summer", null ] }
    }
  },
  "$evaluators": {
    "internal": { "in": [ "@example.com", { "var": "email" } ] }
  }
}
